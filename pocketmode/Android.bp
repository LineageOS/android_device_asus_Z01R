android_app {
    name: "AsusPocketMode",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    required: ["privapp-permissions-pocketmode"],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

}

prebuilt_etc {
    name: "privapp-permissions-pocketmode",
    src: "privapp-permissions-pocketmode.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
